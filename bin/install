#!/bin/bash

set -o pipefail

SCRIPT_NAME=$(basename "${BASH_SOURCE[0]}")
SCRIPT_REAL_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_REAL_PATH")"
PACKAGE_ROOT="$(dirname "${SCRIPT_DIR}")"

source "${PACKAGE_ROOT}/lib/logger.sh"
source "${PACKAGE_ROOT}/lib/core-tools.sh"

install_packages() {
    log_info "installing packages from apt"
    for pkg in $(jq -r .apt_packages[] "$PACKAGE_ROOT/config.json"); do
        log_info "will install package $pkg"
        sudo apt install -y $pkg
        if [[ $? -ne 0 ]]; then
            log_error "received error installing package $pkg"
            exit 1
        fi
    done
}

install_fonts() {
    log_info "installing fonts..."
    local version='2.1.0'
    local fonts_dir="${HOME}/.local/share/fonts"
    if [[ ! -d "$fonts_dir" ]]; then
        mkdir -p "$fonts_dir"
    fi
    for font in $(jq -r .fonts[] "$PACKAGE_ROOT/config.json"); do
        zip_file="${font}.zip"
        download_url="https://github.com/ryanoasis/nerd-fonts/releases/download/v${version}/${zip_file}"
        local "Downloading $download_url"
        wget "$download_url"
        unzip "$zip_file" -d "$fonts_dir"
        rm "$zip_file"
    done

    find "$fonts_dir" -name '*Windows Compatible*' -delete

    fc-cache -fv

}

core_tools() {
    install_signal
    install_ulauncher
    install_starship
    install_wezterm
    install_neovim
    install_go
    install_idea
    install_nvm
}

main() {
    install_fonts
    install_packages
    core_tools
    nvm install
    stow -t ~ */ --dotfiles
    chsh -s $(which zsh)
}

main "$@"
